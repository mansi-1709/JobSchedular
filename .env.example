# ============================================================
# Distributed Job Scheduler – Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- Database -----------------------------------------------
DATABASE_URL="postgresql://jobscheduler:jobscheduler_password@localhost:5432/jobscheduler_db"

# ---- API Server ---------------------------------------------
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000

# ---- JWT ----------------------------------------------------
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# ---- Worker -------------------------------------------------
WORKER_POLL_INTERVAL_MS=2000
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_CONCURRENCY=3

# ---- Scheduler ----------------------------------------------
SCHEDULER_TICK_MS=5000

# ---- Frontend -----------------------------------------------
VITE_API_URL=http://localhost:3000
VITE_WS_URL=http://localhost:3000

# ---- PostgreSQL (Docker) ------------------------------------
POSTGRES_USER=jobscheduler
POSTGRES_PASSWORD=jobscheduler_password
POSTGRES_DB=jobscheduler_db
POSTGRES_PORT=5432
