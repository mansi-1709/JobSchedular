{
  "name": "job-scheduler-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "worker",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:worker": "cd worker && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:worker\" \"npm run dev:frontend\"",
    "build": "npm run build --workspaces",
    "test": "cd backend && npm test",
    "db:migrate": "npx prisma migrate dev --schema=./prisma/schema.prisma",
    "db:generate": "npx prisma generate --schema=./prisma/schema.prisma",
    "db:seed": "cd backend && npx ts-node src/prisma/seed.ts",
    "db:studio": "npx prisma studio --schema=./prisma/schema.prisma",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "^5.14.0"
  }
}
